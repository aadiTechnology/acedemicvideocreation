# Names only. Real values live in a git-ignored .env or in Coolify secrets. Never commit them.

APP_ENV=development                 # production in Coolify
APP_BASE_URL=http://localhost:5174  # https://academics.aaditechnology.com in production

# --- Database (shared PostgreSQL server, database aadi_academic) ---
# Runtime role (cannot create tables): postgresql://aadi_academic_app:...@aadi-postgres:5432/aadi_academic
DATABASE_URL=
# Migrator role, used only by `python -m app.migrate`
MIGRATION_DATABASE_URL=

# --- Sign-in through Aadi Identity (OIDC) ---
AUTH_MODE=oidc                      # "dev" only for local development; refused when APP_ENV=production
SESSION_SECRET=
IDENTITY_ISSUER_URL=                # https://id.aadiprojecttracker.aaditechnology.com
IDENTITY_CLIENT_ID=academics-web
IDENTITY_CLIENT_SECRET=
IDENTITY_PRODUCT_KEY=academics

# --- Storage ---
STORAGE_LOCAL_DIR=./storage        # imported packages and generated assets; a persistent volume in production

# --- Video Engine (internal service, Sprint 6) ---
VIDEO_ENGINE_URL=http://aadi-engine-api:8000
VIDEO_ENGINE_API_KEY=
VIDEO_ENGINE_TIMEOUT_SECONDS=30
